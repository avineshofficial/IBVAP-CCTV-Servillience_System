# ============================================
# IBVAP — Environment Configuration
# Copy to .env and modify as needed
# ============================================

# --- Edge Configuration ---
CAMERA_SOURCE=sample          # Options: rtsp://<url>, /path/to/video.mp4, 0 (webcam), sample
CAMERA_FPS=15                 # Target processing FPS
DETECTION_CONFIDENCE=0.4      # Minimum detection confidence
TRACK_BUFFER=30               # Frames to keep lost tracks alive
NIGHT_ENHANCE_THRESHOLD=60    # Mean luminance below which to enhance (0-255)

# --- Core Configuration ---
CORE_HOST=0.0.0.0
CORE_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db   # Use postgresql+asyncpg://... for production
SECRET_KEY=ibvap-prototype-secret-key-change-in-production
WATCHLIST_HASH_SECRET=changeme-generate-your-own
EDGE_API_KEY=changeme-generate-a-secure-edge-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- Sync ---
CORE_API_URL=http://localhost:8000
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_SIZE=50

# --- Model Paths ---
YOLO_MODEL=yolo11n.pt
FACE_MODEL_PACK=buffalo_l
